{
  "name": "wc3-dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "dev:docs": "cd docs && vite dev",
    "build:docs": "cd docs && vite build",
    "preview": "wrangler dev",
    "preview:docs": "wrangler dev --config wrangler.docs.jsonc --port 5181",
    "dry-run": "wrangler deploy --dry-run",
    "textures": "node scripts/textures.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "biome check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && cd docs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@sveltepress/vite": "1.10.0",
    "@unocss/preset-wind4": "66.12.0",
    "@unocss/vite": "66.12.0",
    "sharp": "0.34.5",
    "shiki": "4.5.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#docs/*": "./docs/src/lib/*"
  }
}
